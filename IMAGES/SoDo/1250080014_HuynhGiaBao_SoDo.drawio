<mxfile host="app.diagrams.net" agent="python" version="24.7.17"><diagram id="MODULE_Khoi" name="00 Sơ đồ khối hệ thống"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1762" value="&lt;b&gt;Người dân&lt;/b&gt;&lt;br&gt;điện thoại / máy tính&lt;br&gt;(trình duyệt, camera, GPS)" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="50" width="170" height="70" as="geometry"/></mxCell><mxCell id="c1763" value="&lt;b&gt;Cán bộ xử lý&lt;/b&gt;&lt;br&gt;máy tính&lt;br&gt;(trình duyệt)" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="300" width="170" height="70" as="geometry"/></mxCell><mxCell id="c1764" value="&lt;b&gt;Đơn vị hiện trường&lt;/b&gt;&lt;br&gt;điện thoại / máy tính bảng&lt;br&gt;(trình duyệt, camera, GPS)" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="540" width="170" height="70" as="geometry"/></mxCell><mxCell id="c1765" value="M6. Bảo mật và phân quyền: đăng nhập, kiểm tra quyền, giới hạn nhập sai, khóa thiết bị đo, ẩn thông tin cá nhân" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;horizontal=0;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="230" y="20" width="40" height="740" as="geometry"/></mxCell><mxCell id="c1766" value="&lt;b&gt;Thiết bị đo IoT&lt;/b&gt;&lt;br&gt;Pico W + MQ135 + TDS&lt;br&gt;(WiFi, đặt tại hiện trường)" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="670" width="170" height="70" as="geometry"/></mxCell><mxCell id="c1767" value="&lt;b&gt;M1. Thu nhận phản ánh&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Trang gửi báo cáo, bổ sung thông tin; gửi mã qua email&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="430" y="40" width="210" height="70" as="geometry"/></mxCell><mxCell id="c1768" value="&lt;b&gt;M7. Công khai và tra cứu&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Trang công khai và tra cứu báo cáo&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="210" height="70" as="geometry"/></mxCell><mxCell id="c1769" value="&lt;b&gt;M4. Xử lý trung tâm và điều phối&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Máy chủ web FastAPI: tiếp nhận, phân công, duyệt kết quả&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="430" y="310" width="210" height="90" as="geometry"/></mxCell><mxCell id="c1770" value="&lt;b&gt;M5. Hiện trường&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Thiết bị của đơn vị; ảnh lưu vào M3&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="430" y="540" width="210" height="70" as="geometry"/></mxCell><mxCell id="c1771" value="&lt;b&gt;M2. Định vị và bản đồ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;OpenStreetMap + Leaflet, GPS trình duyệt&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="720" y="40" width="210" height="70" as="geometry"/></mxCell><mxCell id="c1772" value="&lt;b&gt;M3. Lưu trữ bằng chứng&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Vùng tải lên tạm, vùng bằng chứng lâu dài&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="720" y="170" width="210" height="70" as="geometry"/></mxCell><mxCell id="c1773" value="&lt;b&gt;CSDL SQL Server&lt;/b&gt;&lt;br&gt;báo cáo, phân công,&lt;br&gt;lịch sử, danh mục" style="shape=cylinder3;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="305" width="170" height="100" as="geometry"/></mxCell><mxCell id="c1774" value="&lt;b&gt;M8. Thiết bị đo tự động (IoT)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;API nhận, so ngưỡng, lưu số liệu&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="430" y="670" width="210" height="70" as="geometry"/></mxCell><mxCell id="c1775" value="Dịch vụ bản đồ&lt;br&gt;OpenStreetMap" style="shape=cloud;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1000" y="30" width="160" height="90" as="geometry"/></mxCell><mxCell id="c1776" value="gửi, bổ sung" style="html=1;endArrow=block;endFill=1;endSize=7;rounded=0;strokeColor=#000000;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontSize=