{
  // F5: chạy web ở chế độ gỡ lỗi (đặt điểm dừng trong app/...). Cần đã chạy chay_he_thong.bat một lần để có .venv.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chạy web (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8", "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318" },
      "justMyCode": true
    }
  ]
}
